// =============================================================================
// WIR – Das Mitarbeiterportal (Schloss & Gut Liebenberg / DKB STIFTUNG)
// PostgreSQL / Prisma 7 Schema – Phase 1
//
// Konventionen
// - Tabellen snake_case (Plural) via @@map, Spalten snake_case via @map.
// - Primärschlüssel UUID (gen_random_uuid(), pgcrypto / PG >= 13).
// - created_at / updated_at auf fachlichen Tabellen; Soft Delete via deleted_at
//   bzw. Status DEACTIVATED, wo Audit/Datenschutz/Integrität es verlangen.
// - Content-Registry (content_items): Alle "Inhalte" (News, Übergaben, Wissen,
//   Dokumente, Umfragen, Aufgaben, Checklisten-Läufe, Ideen) teilen sich eine
//   Basistabelle (Shared Primary Key 1:1). Querschnittsfunktionen (Lesestatus,
//   Erinnerungen, Kommentare, Reaktionen, Anhänge, Zielgruppen, ACL, Suche)
//   referenzieren content_items per echtem Foreign Key – keine polymorphen IDs.
//   Siehe ARCHITECTURE_DECISIONS.md, ADR-004.
// - Nicht in Prisma ausdrückbar und per SQL-Migration zu ergänzen
//   (siehe Kommentare "RAW-SQL"): CHECK-Constraints, GIN-Indizes auf tsvector,
//   UNIQUE ... NULLS NOT DISTINCT, pgvector, Append-only-Rechte für audit_logs.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Verbindung (DATABASE_URL) steht in prisma.config.ts (Prisma 7).
// Erweiterungen pgcrypto, pg_trgm, unaccent legt die Init-Migration an.
datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum ReadListVisibility {
  AUTHOR_AND_LEADS // Spec §20 – voreingestellt
  ALL_RECIPIENTS // nur nach Betriebsvereinbarung (ADR-012)
}

enum CompanyKind {
  FOUNDATION // Stiftungsebene (gruppenweite Inhalte, Stiftungsadmins)
  LOCATION // Wirkungsort / Marke mit eigenem Auftritt, z. B. Schloss & Gut Liebenberg
  LEGAL_ENTITY // rechtliche Gesellschaft unterhalb eines Wirkungsorts
}

// Fachmodule, die je Gesellschaft abgeschaltet werden können (ADR-039).
// Beispiel: Die Stiftungsebene braucht keine Übergaben, Checklisten, Dienstpläne
// oder Belegungszahlen – diese Module sind dort deaktiviert.
enum AppModule {
  NEWS
  SOCIAL
  CHAT
  KNOWLEDGE
  DOCUMENTS
  TASKS
  CHECKLISTS
  HANDOVERS
  SHIFTS // Dienstplan-Anzeige (Gastromatic)
  OCCUPANCY // Belegung, An-/Abreisen (Flexkeeping)
  EVENTS // Veranstaltungen & Räume (Eventtool)
  SURVEYS
  IDEAS
  CONTACTS
  TEAM
  MEETINGS
}

enum UserStatus {
  PROVISIONED // automatisch aus Gastromatic angelegt, wartet auf Freischaltung (ADR-021)
  INVITED // freigeschaltet, Einmal-Code ausgegeben, noch nicht eingeloggt
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum UserType {
  EMPLOYEE
  EXTERNAL // z. B. Dienstleister, Aushilfe, Partner – Account ohne vollständiges Profil
  SERVICE // technische Accounts (Integrationen)
