# Kopiere diese Datei nach packages/db/.env und apps/api/.env (Codespaces braucht das nicht).
DATABASE_URL=postgresql://wir:wir@localhost:5432/wir
# In Produktion ein langes Zufallsgeheimnis setzen (z. B. openssl rand -base64 48)
APP_SECRET=nur-fuer-entwicklung-bitte-aendern
API_URL=http://localhost:3001
DEFAULT_COMPANY=SGL
# KI-Assistent (optional, OpenAI-kompatible Schnittstelle, z. B. STACKIT AI Model Serving). Ohne Angabe: nur Fundstellen.
# AI_BASE_URL=https://…/v1
# AI_MODEL=…
# AI_API_KEY=…
# Push aufs Handy (optional; ohne Angabe werden Entwicklungsschlüssel erzeugt). Erzeugen: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=…
# VAPID_PRIVATE_KEY=…
# VAPID_SUBJECT=mailto:it@…
# Hintergrund-Erinnerungen abschalten: JOBS=off
# Demo-Modus: Personen ohne Passwort wechseln – NUR mit Testdaten (npm run setup), nie produktiv
# DEMO_MODE=true

# Übersetzung (ADR-054) – leer lassen = aus; vorhandene Übersetzungen werden trotzdem angezeigt
# DeepL API Pro (mit AVV) für Übersetzungen
DEEPL_API_KEY=
# DEEPL_API_URL=https://api.deepl.com/v2/translate
# KI-Modell mit OpenAI-kompatibler Schnittstelle (z. B. STACKIT AI Model Serving) für Leichte Sprache
# – und für Übersetzungen, falls kein DeepL-Schlüssel gesetzt ist
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Heute im Haus (ADR-057): Mews Connector API – ohne diese Werte gibt es Hauszahlen nur im Demo-Modus (erfundene Zahlen)
# MEWS_URL=https://api.mews.com
# MEWS_CLIENT_TOKEN=
# MEWS_ACCESS_TOKEN=
# MEWS_SERVICE_ID=
# Wetter-Standort (Standard: Liebenberg)
# WEATHER_LAT=52.87
# WEATHER_LON=13.29
